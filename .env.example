# ==============================================================================
# YAAN BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Core Configuration
APP_NAME="Yaan Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yaan-backend.onrender.com
APP_FRONTEND_URL=https://yaan-backend.onrender.com
API_BASE_URL=https://yaan-backend.onrender.com/api

# Localization & Security
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging Configuration (stderr is optimized for Render container logs)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (Neon PostgreSQL for Render)
DB_CONNECTION=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=require
DB_URL=

# Auto-run database migrations on Docker container startup (true/false)
RUN_MIGRATIONS=true

# Session, Cache, Queue & Storage
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Server Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super Admin Initial Credentials (minimum 10 characters; never commit real password)
ADMIN_EMAIL=admin@yaan.com
ADMIN_PASSWORD=

# Firebase Integration
FIREBASE_CREDENTIALS=/etc/secrets/firebase-credentials.json
FIREBASE_PROJECT_ID=yaan-12663
# FIREBASE_BYPASS only works when APP_ENV=local
FIREBASE_BYPASS=false

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Maps API Integration
GOOGLE_MAPS_API_KEY=

# Sanctum Token Expiration in Minutes (43200 = 30 days)
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# AWS S3 / Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Frontend Reference
VITE_APP_NAME="${APP_NAME}"
