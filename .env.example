# ==============================================================================
# YAAN BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION FOR RENDER / DOCKER
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core Configuration
# ------------------------------------------------------------------------------
APP_NAME="Yaan Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
API_BASE_URL=https://your-service-name.onrender.com/api

# Localization & Security
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging Configuration (stderr is optimized for Render container logs)
# ------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL for Render)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=ep-curly-brook-axbavkx0.c-4.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_b3qmYRF8jKlr
DB_SSLMODE=require
DB_URL="postgresql://neondb_owner:npg_b3qmYRF8jKlr@ep-curly-brook-axbavkx0.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auto-run database migrations on Docker container startup (true/false)
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# Session, Cache, Queue & Storage
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail Server Configuration (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Firebase Integration
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=yaan-12663
# Set 'true' if Firebase credentials file is not uploaded yet to prevent 500 boot crashes
FIREBASE_BYPASS=true

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Integration
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# AWS S3 / Cloud Storage (Optional)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Frontend Reference
VITE_APP_NAME="${APP_NAME}"
